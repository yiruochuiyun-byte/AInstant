{
  "name": "ainstant",
  "version": "1.0.0",
  "description": "AInstant: AI news aggregation pipeline",
  "scripts": {
    "pipeline": "node --env-file-if-exists=.env pipeline/run.ts",
    "offline": "AINSTANT_OFFLINE=1 PGLITE_DIR=.pglite-offline node pipeline/run.ts && PGLITE_DIR=.pglite-offline node scripts/top.ts",
    "top": "node --env-file-if-exists=.env scripts/top.ts",
    "submit": "node --env-file-if-exists=.env scripts/submit.ts",
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "digest": "node --env-file-if-exists=.env pipeline/digest.ts",
    "dev:offline": "npm run offline && PGLITE_DIR=.pglite-offline ADMIN_PASSWORD=admin next dev"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "fast-xml-parser": "^5.11.2",
    "next": "^16.4.3",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@electric-sql/pglite-pgvector": "^0.0.12",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  }
}
