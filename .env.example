# Supabase → Project Settings → Database → Connection string (use the pooler URI). Leave empty to use local PGlite.
DATABASE_URL=
# console.anthropic.com → API keys
ANTHROPIC_API_KEY=
# dash.voyageai.com → API keys
VOYAGE_API_KEY=
# Optional: override the model used for labeling (default claude-haiku-5-5)
AINSTANT_MODEL=
# Optional: self-hosted RSSHub for Weibo / Jike / Zhihu routes, e.g. https://rsshub.example.up.railway.app
RSSHUB_URL=
