# Supabase → Project Settings → Database → Connection string (pooler URI). Empty = local PGlite.
DATABASE_URL=
# console.anthropic.com → API keys
ANTHROPIC_API_KEY=
# dash.voyageai.com → API keys
VOYAGE_API_KEY=
# Optional: model used for labeling, headlines and translation (default claude-haiku-5-5)
AINSTANT_MODEL=
# Optional: self-hosted RSSHub for Weibo / Jike / Zhihu, e.g. https://rsshub.example.up.railway.app
RSSHUB_URL=

# Website
SITE_URL=http://localhost:3000
ADMIN_PASSWORD=
# Shared secret for POST /api/ingest (Grok bot)
INGEST_TOKEN=
# resend.com → API keys. Empty = emails are logged, not sent.
RESEND_API_KEY=
EMAIL_FROM=AInstant <digest@your-domain>
# Shown in the privacy policy: name, address, contact email
SITE_OPERATOR=
